@model CatLens.Web.Models.Reviews.HighInventoryReviewViewModel

@{
    ViewData["Title"] = "High Inventory Review";

    var firstItem = Model.WarningCount == 0
        ? 0
        : ((Model.CurrentPage - 1) * Model.PageSize) + 1;

    var lastItem = Math.Min(
        Model.CurrentPage * Model.PageSize,
        Model.WarningCount);
}

<div class="mb-4">
    <h1 class="display-5">Data Review</h1>

    <p class="text-muted">
        Variants that may need manual verification.
        CatLens does not change Shopify data.
    </p>
</div>

<div class="btn-group mb-4" role="group">
    <a class="btn btn-outline-secondary" asp-action="Index">
        Missing SKU
    </a>

    <a class="btn btn-outline-secondary" asp-action="DuplicateSkus">
        Duplicate SKU
    </a>

    <a class="btn btn-primary" asp-action="HighInventory">
        High Inventory
    </a>
</div>

<div class="alert alert-warning" role="alert">
    <div class="fw-semibold">
        Rule 3: High inventory
    </div>

    <div>
        An inventory level is shown when its on-hand
        quantity is greater than
        <strong>@Model.Threshold.ToString("N0")</strong>
        at one location.
    </div>

    <div class="mt-2">
        This is only a warning for human verification.
        It does not mean the inventory data is incorrect.
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <div class="d-flex flex-wrap
            justify-content-between
            align-items-center gap-2">

            <div>
                <span class="fw-semibold">
                    High inventory warnings
                </span>

                <span class="badge text-bg-warning ms-2">
                    @Model.WarningCount.ToString("N0")
                </span>
            </div>

            <span class="text-muted">
                Showing @firstItem–@lastItem
                of @Model.WarningCount.ToString("N0")
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>Variant</th>
                    <th>SKU</th>
                    <th>Location</th>
                    <th class="text-end">On hand</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var options = new[]
                    {
                        row.Option1Value,
                        row.Option2Value,
                        row.Option3Value
                    }
                    .Where(value =>
                        !string.IsNullOrWhiteSpace(value))
                    .ToArray();

                    <tr>
                        <td>
                            <div class="fw-semibold">
                                @row.Title
                            </div>

                            <small class="text-muted">
                                @row.Handle
                            </small>
                        </td>

                        <td>
                            @if (options.Length == 0)
                            {
                                <span class="text-muted">
                                    Default
                                </span>
                            }
                            else
                            {
                                @string.Join(" / ", options)
                            }
                        </td>

                        <td>
                            @if (string.IsNullOrWhiteSpace(row.Sku))
                            {
                                <span class="badge text-bg-warning">
                                    Missing
                                </span>
                            }
                            else
                            {
                                <code>@row.Sku</code>
                            }
                        </td>

                        <td>@row.Location</td>

                        <td class="text-end
                            fw-semibold
                            text-warning">
                            @row.OnHandQuantity.ToString("N0")
                        </td>
                    </tr>
                }

                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No inventory levels exceed the threshold.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            <nav aria-label="High inventory pages">
                <ul class="pagination
                    justify-content-center mb-0">

                    <li class="page-item
                        @(Model.CurrentPage == 1
    ? "disabled"
    : null)">

                        <a class="page-link" asp-action="HighInventory" asp-route-page="@(Model.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">
                            Page @Model.CurrentPage
                            of @Model.TotalPages
                        </span>
                    </li>

                    <li class="page-item
                        @(Model.CurrentPage == Model.TotalPages
    ? "disabled"
    : null)">

                        <a class="page-link" asp-action="HighInventory" asp-route-page="@(Model.CurrentPage + 1)">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>