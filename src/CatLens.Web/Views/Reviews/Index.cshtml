@model CatLens.Web.Models.Reviews.ReviewIndexViewModel

@{
    ViewData["Title"] = "Data Review";

    var firstItem = Model.MissingSkuCount == 0
        ? 0
        : ((Model.CurrentPage - 1) * Model.PageSize) + 1;

    var lastItem = Math.Min(
        Model.CurrentPage * Model.PageSize,
        Model.MissingSkuCount);
}

<div class="mb-4">
    <h1 class="display-5">Data Review</h1>

    <p class="text-muted">
        Variants that may need manual verification.
        CatLens does not change Shopify data.
    </p>
</div>


    
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="btn-group shadow-sm" role="group" aria-label="Review rules">

        <a asp-controller="Reviews" asp-action="Index" class="btn btn-primary px-3">
            Missing SKU
        </a>

        <a asp-controller="Reviews" asp-action="DuplicateSkus" class="btn btn-outline-secondary px-3">
            Duplicate SKU
        </a>

        <a asp-controller="Reviews" asp-action="HighInventory" class="btn btn-outline-secondary px-3">
            High Inventory
        </a>
    </div>

    <a asp-controller="Reviews" asp-action="ExportMissingSkus" class="btn btn-outline-success px-3 shadow-sm">
        ↓ Export Missing SKU CSV
    </a>
</div>

<div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4">
    <div class="fw-semibold">
        Rule 1: Missing SKU
    </div>

    <div>
        A variant is included when its SKU is blank
        after whitespace is removed.
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="card-header bg-white">
        <div class="d-flex flex-wrap
            justify-content-between
            align-items-center gap-2">

            <div>
                <span class="fw-semibold">
                    Missing SKU variants
                </span>

                <span class="badge text-bg-warning ms-2">
                    @Model.MissingSkuCount.ToString("N0")
                </span>
            </div>

            <span class="text-muted">
                Showing @firstItem–@lastItem
                of @Model.MissingSkuCount.ToString("N0")
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>Variant</th>
                    <th>SKU</th>
                    <th>Locations</th>
                    <th class="text-end">Total on hand</th>
                </tr>
            </thead>

            <tbody>
                @foreach (
                    var variant in Model.MissingSkuVariants)
                {
                    var options = new[]
                    {
                        variant.Option1Value,
                        variant.Option2Value,
                        variant.Option3Value
                    }
                    .Where(value =>
                        !string.IsNullOrWhiteSpace(value))
                    .ToArray();

                    <tr>
                        <td>
                            <div class="fw-semibold">
                                @variant.Title
                            </div>

                            <small class="text-muted">
                                @variant.Handle
                            </small>
                        </td>

                        <td>
                            @if (options.Length == 0)
                            {
                                <span class="text-muted">
                                    Default
                                </span>
                            }
                            else
                            {
                                @string.Join(" / ", options)
                            }
                        </td>

                        <td>
                            <span class="badge text-bg-warning">
                                Missing
                            </span>
                        </td>

                        <td>
                            @variant.LocationCount
                        </td>

                        <td class="text-end fw-semibold">
                            @variant.TotalOnHand.ToString("N0")
                        </td>
                    </tr>
                }

                @if (Model.MissingSkuVariants.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No variants with missing SKU were found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            <nav aria-label="Missing SKU pages">
                <ul class="pagination
                    justify-content-center mb-0">

                    <li class="page-item
                        @(Model.CurrentPage == 1
? "disabled"
: null)">

                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">
                            Page @Model.CurrentPage
                            of @Model.TotalPages
                        </span>
                    </li>

                    <li class="page-item
                        @(Model.CurrentPage == Model.TotalPages
? "disabled"
: null)">

                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>